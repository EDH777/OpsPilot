# 复制为 .env 后填入真实值
#
# 任意 OpenAI 兼容端点均可。没有 Key 也能体验完整产品：
# 启动后登录，勾选「离线演示」，用脚本化模型跑通「调查 → 工具 → 报告」全链路。
OPSPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
OPSPILOT_LLM_API_KEY=
OPSPILOT_LLM_MODEL=deepseek-chat
OPSPILOT_LLM_MAX_TOKENS=8192

# 阿里云百炼 / MAAS 示例（把 base_url 换成你的兼容端点）
# OPSPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPSPILOT_LLM_MODEL=qwen3.7-max

# 预算（可选）
# OPSPILOT_MAX_STEPS=24
# OPSPILOT_MAX_TOOL_CALLS=40
# OPSPILOT_MAX_TOKENS=180000
# OPSPILOT_MAX_SECONDS=900
# OPSPILOT_CONTEXT_TOKEN_BUDGET=30000

# 沙箱：subprocess（开发机）或 docker（生产隔离）
# OPSPILOT_SANDBOX=subprocess
# OPSPILOT_SANDBOX_TIMEOUT_S=30

# 演示级认证（生产必须改掉演示密码并配置随机 secret）
OPSPILOT_SESSION_SECRET=change-me-to-a-random-32-byte-secret
OPSPILOT_DEMO_PASSWORD=OpsPilot@2026
OPSPILOT_COOKIE_SECURE=false
OPSPILOT_ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100

# 业务 API（默认连接随包启动的 mock ERP）
# OPSPILOT_BUSINESS_API_BASE=http://127.0.0.1:8101
# OPSPILOT_BUSINESS_API_TOKEN=change-me
