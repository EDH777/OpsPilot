# 复制为 .env 后填入真实值
OPSPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
OPSPILOT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
OPSPILOT_LLM_MODEL=deepseek-chat
OPSPILOT_LLM_MAX_TOKENS=8192

# 预算（可选）
# OPSPILOT_MAX_STEPS=24
# OPSPILOT_MAX_TOKENS=300000
# OPSPILOT_MAX_SECONDS=900
# OPSPILOT_CONTEXT_TOKEN_BUDGET=30000

# 沙箱：subprocess（开发机）或 docker（生产隔离）
# OPSPILOT_SANDBOX=subprocess
